# Copy to .env and fill in. The real .env is gitignored.
#
# Loaded by app/env.py at import time (KEY=VALUE per line, # for
# comments). No quoting; no escapes. Existing environment variables
# take precedence — exporting in ~/.bashrc still wins.

ANTHROPIC_API_KEY=

# Optional overrides — defaults live in the service modules.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Observability (optional) -------------------------------------------
# Sentry: error monitoring. Get a DSN from sentry.io after creating a
# project. Soft-fails if unset — the app runs fine without it.
SENTRY_DSN=
# 'local' | 'staging' | 'prod' — tags events so prod errors are filterable.
# SENTRY_ENVIRONMENT=local
# Trace sample rate. Defaults: 1.0 for local, 0.1 for non-local.
# SENTRY_TRACES_SAMPLE_RATE=
# Release tag. Defaults to the version in pyproject.toml.
# SENTRY_RELEASE=

# --- Supabase (Phase 1+ of the auth/Postgres migration) ----------------
# Project Settings → API in the Supabase dashboard.
SUPABASE_URL=
# Public (safe in browser). Used by the magic-link client init.
SUPABASE_ANON_KEY=
# Server-only. NEVER ship to the browser. Used for admin / verify flows.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string → Session pooler.
# Has the DB password embedded. Used by psycopg for direct schema /
# data work (migrations, exports).
DATABASE_URL=
# Project Settings → API → JWT Settings → JWT Secret. Used to verify
# JWT signatures on every request (LIS-280). REQUIRED in production;
# local dev falls back to unverified decode with a loud warning.
SUPABASE_JWT_SECRET=

# --- Deploy hardening (LIS-280) -----------------------------------------
# Diagnostics endpoints (/__sentry/*, /__claude/*). 1 = on, 0 = off.
# Defaults: on for local dev, off in production.
# LIS_DIAGNOSTICS_ENABLED=0
# Daily Anthropic-token cap per user. Circuit breaker against runaway
# loops; the LLM-touching services degrade to their offline fallback
# when this is hit. Default 200000 tokens.
# ANTHROPIC_DAILY_TOKEN_CAP=200000

# --- Personal-access allowlist (single-tenant production) ---------------
# Supabase OAuth lets anyone with a GitHub account complete the flow.
# To keep bench.libearden.dev single-tenant, set at least one of these
# in production. Either matches → access granted. Leave both unset in
# local dev = no restriction (multi-user-friendly).
# Comma-separated. Case-insensitive on emails.
# LIS_ALLOWED_USER_IDS=
# LIS_ALLOWED_EMAILS=

# Admin / operator allowlist (LIS-301). Used by the feedback↔GH
# integration to (a) auto-promote operator-typed feedback to GitHub
# issues, and (b) unlock the cross-user admin scope in the feedback
# inbox. UUIDs only (email-equality is too easy to spoof for an
# admin gate). If unset, falls back to LIS_ALLOWED_USER_IDS so
# single-tenant deploys don't need a second var.
# LIS_ADMIN_USER_IDS=

# --- Feedback → GitHub Issues (LIS-301) ---------------------------------
# Fine-grained PAT or classic-PAT with `issues: read+write` scope on
# the target repo. Soft-fails if unset; rows stay in the inbox.
# GITHUB_FEEDBACK_TOKEN=
# OWNER/REPO to create issues against. Defaults to the canonical
# LiBearden/research-engineer-interview-prep — set this for forks or
# private mirrors.
# GITHUB_FEEDBACK_REPO=LiBearden/research-engineer-interview-prep

# --- Access-request notifications (operator alerts) ---------------------
# When someone hits /request-access we always record the row; if these
# are set we also send a transactional email so you don't have to poll
# the DB. Soft-fails — missing keys just skip the send.
# Resend.com — free tier (3000/mo, 100/day) is fine.
# RESEND_API_KEY=
# Where to send the alert. Defaults: nothing sent unless this is set.
# OPERATOR_NOTIFY_EMAIL=
# Verified-sender on Resend (must own the domain + add SPF/DKIM).
# Defaults to bench@libearden.dev.
# OPERATOR_NOTIFY_FROM=
